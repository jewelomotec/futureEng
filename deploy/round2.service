[Unit]
Description=WRO Round 2 block detector
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/Documents/Test2_Round2
ExecStart=/home/pi/Documents/Test2_Round2/venv/bin/python -u /home/pi/Documents/Test2_Round2/round2.py
Restart=always
RestartSec=2
Environment=DISPLAY=:0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
