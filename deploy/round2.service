# Official name: Round 2 service
# systemd unit name on the Pi: round2
# Starts the Pi race copy: round2.py (paste from detect.py)
# Catalog: docs/CODE_CATALOG.md
[Unit]
Description=WRO Round 2 block detector
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/Documents/Test2_Round2
ExecStart=/home/pi/Documents/Test2_Round2/venv/bin/python -u /home/pi/Documents/Test2_Round2/round2.py
Restart=always
RestartSec=2
Environment=DISPLAY=:0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
